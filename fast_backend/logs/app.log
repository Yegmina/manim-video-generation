CREATE TABLE scene_collection (
	id INTEGER NOT NULL, 
	title VARCHAR(500) NOT NULL, 
	description TEXT, 
	original_prompt TEXT NOT NULL, 
	total_scenes INTEGER, 
	completed_scenes INTEGER, 
	status VARCHAR(50), 
	quality VARCHAR(50), 
	format VARCHAR(10), 
	final_video_path VARCHAR(1000), 
	final_video_size INTEGER, 
	total_duration FLOAT, 
	user_id INTEGER, 
	ip_address VARCHAR(45), 
	user_agent TEXT, 
	scene_metadata JSON, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP, 
	updated_at DATETIME, 
	started_at DATETIME, 
	completed_at DATETIME, 
	processing_time FLOAT, 
	is_active BOOLEAN, 
	notes TEXT, 
	PRIMARY KEY (id), 
	FOREIGN KEY(user_id) REFERENCES user (id)
)


